<Window x:Class="uklady_panele.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:uklady_panele"
        mc:Ignorable="d"
        Title="MainWindow" Height="250" Width="400">
    <StackPanel>
        <StackPanel Orientation="Horizontal" Margin="20">
            <Label Content="Podaj swoje imię: "/>
            <TextBox Width="200" Height="30" Name="txtImie"/>
        </StackPanel>

        <Button Content="Witaj" Width="60" Height="35" x:Name="btnWitaj" Click="btnWitaj_Click"/>
        <Label Name="lblKomunikat" HorizontalAlignment="Center"                                                                                                                            />
    </StackPanel>
</Window>
